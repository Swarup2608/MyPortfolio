# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development

PORT=5000

# Frontend origin allowed by CORS (comma-separate multiple origins if needed)
FRONTEND_URL=http://localhost:3000

# Publicly reachable base URL of this server (used to build local upload URLs)
PUBLIC_SERVER_URL=http://localhost:5000

# MongoDB connection string. Required.
MONGODB_URI=

# Required, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
IP_HASH_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Cookie settings. Use lax+false for local http dev.
# In production over HTTPS with frontend/server on different domains, use none+true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Protects the daily cleanup of unsaved image uploads (/api/internal/cleanup-media).
# Vercel Cron sends it automatically. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# First admin account (used by `npm run create-admin`)
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Image storage: "local" (disk, default) or "r2" (Cloudflare R2 / S3-compatible)
#   local: uploads go to LOCAL_UPLOAD_DIR while editing. If the R2_* values below are
#          also set, saving a post/project moves its images to R2 and rewrites the URLs.
#   r2:    uploads go straight to R2 (use this on serverless hosts like Vercel, where
#          local disk isn't persistent).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# Needed for STORAGE_DRIVER=r2, and for moving images to R2 on save with STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
